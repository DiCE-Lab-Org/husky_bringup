<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>husky_bringup</name>
  <version>0.0.0</version>
  <description>Bringup launch files for Husky A200 with dual UR5e arms and Robotiq grippers</description>
  <maintainer email="bbeheshtishira7627@sdsu.edu">Behrad Beheshti</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>husky_description</exec_depend>
  <exec_depend>husky_dual_ur_moveit_config</exec_depend>
  <exec_depend>husky_commander</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
